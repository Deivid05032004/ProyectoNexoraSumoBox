{
  "info": {
    "name": "UTA SUMO ROBOTICS CUP API (implementado)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección completa: health, autenticación, catálogos, recursos, inscripciones, pagos, administración y reportes."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health API",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health/live"
      }
    },
    {
      "name": "Health SQL Server",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health"
      }
    },
    {
      "name": "Categorías",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/categories"
      }
    },
    {
      "name": "Instituciones",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/institutions"
      }
    },
    {
      "name": "Eventos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/events"
      }
    },
    {
      "name": "Tarifas vigentes",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/tariffs?event_id={{eventId}}&category_id={{categoryId}}"
      }
    },
    {
      "name": "Registrar participante",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{participantEmail}}\",\n  \"password\": \"{{participantPassword}}\",\n  \"first_name\": \"Nombre\",\n  \"last_name\": \"Apellido\",\n  \"institution_id\": {{institutionId}},\n  \"mobile_phone\": \"0990000000\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registro por email creado', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.environment.set('token', pm.response.json().access_token); pm.environment.set('participantUsername', pm.response.json().user.email); pm.environment.set('userId', pm.response.json().user.user_id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{participantUsername}}\",\n  \"password\": \"{{participantPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login por email correcto', function () { pm.response.to.have.status(200); });",
              "if(pm.response.code===200)pm.environment.set('token',pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Iniciar sesión o registrar con Google",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_token\": \"{{googleIdToken}}\",\n  \"institution_id\": {{institutionId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/google",
        "description": "Usa un ID token vigente emitido para el mismo GOOGLE_CLIENT_ID configurado en el backend.",
        "auth": {
          "type": "noauth"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Google auth responde 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { const r = pm.response.json(); pm.environment.set(\"token\", r.access_token); pm.environment.set(\"userId\", r.user.user_id); pm.environment.set(\"participantEmail\", r.user.email); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Vincular Google a mi cuenta autenticada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_token\": \"{{googleIdToken}}\",\n  \"institution_id\": {{institutionId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/google/link",
        "description": "Usa un ID token vigente emitido para el mismo GOOGLE_CLIENT_ID configurado en el backend.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Vinculación Google responde 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Usuario autenticado",
