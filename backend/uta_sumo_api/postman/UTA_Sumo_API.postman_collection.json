              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Subir comprobante",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}/receipt",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "payment_reference",
                  "type": "text",
                  "value": "referencia-demo"
                }
              ]
            }
          }
        },
        {
          "name": "Descargar comprobante",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}/receipt",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Pagos en revisión",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/payments?status=IN_REVIEW&page=1&limit=50",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{treasuryToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Revisar pago",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}/review",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{treasuryToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PAID\",\n  \"comments\": \"Comprobante revisado\"\n}"
            }
          }
        },
        {
          "name": "Revisar inscripción",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/registrations/{{registrationId}}/review",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"comments\": \"Datos verificados\"\n}"
            }
          }
        },
        {
          "name": "Cancelar inscripción",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/registrations/{{registrationId}}/cancel",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
