{
  "info": {
    "name": "UTA SUMO - Flujo E2E local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Prueba autenticada: inicios por rol, equipo/robot, inscripción, reportes y control de permisos. Tras inicializar cuentas, usa las contraseñas aleatorias impresas y los IDs demo del entorno local. La opción bootstrap --run-postman automatiza el environment temporal y lo elimina al terminar."
  },
  "item": [
    {
      "name": "Health + SQL Server",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"API conectada a SQL Server\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Login ADMIN",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login ADMIN HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.environment.set(\"adminToken\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login REVIEWER",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{reviewerUsername}}\",\n  \"password\": \"{{reviewerPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login REVIEWER HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.environment.set(\"reviewerToken\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login TREASURY",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{treasuryUsername}}\",\n  \"password\": \"{{treasuryPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login TREASURY HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.environment.set(\"treasuryToken\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login PARTICIPANT",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{participantUsername}}\",\n  \"password\": \"{{participantPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login PARTICIPANT HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.environment.set(\"participantToken\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Perfil participante",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/participants/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{participantToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Perfil disponible\", function () { pm.response.to.have.status(200); });",
              "pm.environment.set(\"participantId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear equipo",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/teams",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{participantToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Equipo Postman {{$randomUUID}}\",\n  \"institution_id\": \"{{institutionId}}\",\n  \"contact_phone\": null\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Equipo creado\", function () { pm.response.to.have.status(201); });",
              "pm.environment.set(\"teamId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear robot",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/robots",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{participantToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Robot Postman {{$randomUUID}}\",\n  \"robot_description\": \"Equipo de demostración local\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Robot creado\", function () { pm.response.to.have.status(201); });",
              "pm.environment.set(\"robotId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear inscripción y tarifa",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/registrations",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{participantToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"{{eventId}}\",\n  \"category_id\": \"{{categoryId}}\",\n  \"team_id\": \"{{teamId}}\",\n  \"robot_id\": \"{{robotId}}\",\n  \"participants\": [\n    {\n      \"participant_id\": \"{{participantId}}\",\n      \"role\": \"PARTICIPANT\"\n    }\n  ],\n  \"notes\": \"Prueba end-to-end de Postman\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Inscripción creada con pago pendiente\", function () { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql(\"PAYMENT_PENDING\"); });",
              "pm.environment.set(\"registrationId\", pm.response.json().id);",
              "pm.environment.set(\"paymentId\", pm.response.json().payment_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Subir comprobante PDF",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}/receipt",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{participantToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "postman/fixtures/demo-receipt.pdf",
              "contentType": "application/pdf"
            },
            {
              "key": "payment_reference",
              "type": "text",
              "value": "DEMO-TRANSFER-POSTMAN"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Comprobante aceptado y puesto en revisión\", function () { pm.response.to.have.status(202); pm.expect(pm.response.json().status).to.eql(\"IN_REVIEW\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Descargar comprobante propio",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}/receipt",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{participantToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Descarga PDF autorizada\", function () { pm.response.to.have.status(200); pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Tesorería verifica pago",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}/review",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{treasuryToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"PAID\",\n  \"comments\": \"Comprobante sintético validado por Newman\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pago registrado como pagado\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql(\"PAID\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Revisor aprueba inscripción",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/registrations/{{registrationId}}/review",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{reviewerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"APPROVED\",\n  \"comments\": \"Datos de demostración verificados\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Inscripción aprobada\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql(\"APPROVED\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Historial completo de inscripción",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/registrations/{{registrationId}}/history",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{participantToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Historial contiene transición de aprobación\", function () { const h = pm.response.json(); pm.response.to.have.status(200); pm.expect(h[h.length-1].new_status).to.eql(\"APPROVED\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Leer inscripción propia",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/registrations/{{registrationId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{participantToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Inscripción propia aprobada\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql(\"APPROVED\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reporte ejecutivo ADMIN",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/reports/overview?event_id={{eventId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"KPI del evento\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().registrations.total).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reporte de estados REVIEWER",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/reports/registrations/by-status?event_id={{eventId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{reviewerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Desglose de estados\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().items).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reporte financiero TREASURY",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/reports/payments/summary?event_id={{eventId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{treasuryToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Resumen financiero\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().total_count).to.be.above(0); pm.expect(pm.response.json().items.some(x => x.status === \"PAID\")).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Rol PARTICIPANT no puede ver finanzas",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/reports/payments/summary",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{participantToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Finanzas restringidas\", function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reporte detallado paginado REVIEWER",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/reports/registrations/details?event_id={{eventId}}&page=1&limit=10",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{reviewerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Reporte detallado paginado REVIEWER\", function () { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.page).to.eql(1); pm.expect(body.total).to.be.above(0); pm.expect(body.items).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reporte detallado paginado TREASURY",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/reports/payments/details?event_id={{eventId}}&page=1&limit=10",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{treasuryToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Reporte detallado paginado TREASURY\", function () { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.page).to.eql(1); pm.expect(body.total).to.be.above(0); pm.expect(body.items).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    }
  ]
}
