{
  "info": {
    "name": "UTA SUMO - Smoke test local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Verifica API y SQL Server en vivo, catálogos públicos y controles de autenticación sin crear ni modificar datos."
  },
  "item": [
    {
      "name": "Liveness",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health/live"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
