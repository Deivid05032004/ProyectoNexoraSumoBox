# Copia a .env y configura valores reales antes de usar Docker Compose.
# Genera cada secreto con: python -c "import secrets; print(secrets.token_urlsafe(48))"
DB_SERVER=db
DB_NAME=UTA_SUMO_ROBOTICS_CUP
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_AUTH_MODE=sql
DB_TRUST_SERVER_CERTIFICATE=yes
DB_USERNAME=uta_api
DB_PASSWORD=CAMBIAR_POR_CLAVE_SQL_SEGURA
MIGRATION_DB_USERNAME=sa
MSSQL_SA_PASSWORD=CAMBIAR_POR_CLAVE_SQL_ADMIN
# Developer es solo para pruebas. Cambia por una edición con licencia en producción.
DB_EDITION=Developer

SECRET_KEY=CAMBIAR_POR_SECRETO_ALEATORIO
PII_ENCRYPTION_KEY=CAMBIAR_POR_CLAVE_DE_CIFRADO_ESTABLE
GOOGLE_CLIENT_ID=
EMAIL_CHECK_DELIVERABILITY=true
AUTO_BOOTSTRAP_DEMO_ACCOUNTS=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:8080
RECEIPT_STORAGE_DIR=/app/storage/receipts
MAX_RECEIPT_BYTES=5242880
REGULATION_STORAGE_DIR=/app/storage/regulations
MAX_REGULATION_BYTES=20971520

# SMTP opcional. Sin valores, el correo queda en EmailOutbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=UTA SUMO ROBOTICS CUP
SMTP_STARTTLS=true

# Vite incorpora estos valores en la compilación del frontend.
VITE_API_BASE_URL=http://localhost:8080
HTTP_PORT=8080
PUBLIC_DOMAIN=localhost
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
