# SQL Server local con autenticación integrada de Windows.
DB_SERVER=.\SQLEXPRESS
DB_NAME=UTA_SUMO_ROBOTICS_CUP
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_AUTH_MODE=windows
DB_TRUST_SERVER_CERTIFICATE=yes
# Solo se usan cuando DB_AUTH_MODE=sql. No pongas credenciales reales aquí.
DB_USERNAME=
DB_PASSWORD=

# Sustituye por una clave aleatoria de al menos 32 caracteres.
SECRET_KEY=
PII_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=988847548981-9s6cu320r2g06dmbrfumvvrgdken2r7a.apps.googleusercontent.com
EMAIL_CHECK_DELIVERABILITY=true
AUTO_BOOTSTRAP_DEMO_ACCOUNTS=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RECEIPT_STORAGE_DIR=
MAX_RECEIPT_BYTES=5242880
REGULATION_STORAGE_DIR=
MAX_REGULATION_BYTES=20971520

# SMTP opcional. Si no se configura, el correo queda pendiente en EmailOutbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=UTA SUMO ROBOTICS CUP
SMTP_STARTTLS=true
